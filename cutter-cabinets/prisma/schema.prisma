generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUTTER
  ADMIN
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id                    String          @id @default(uuid())
  login                 String          @unique
  displayName           String
  passwordHash          String
  role                  UserRole        @default(CUTTER)
  isActive              Boolean         @default(true)
  mustChangePassword    Boolean         @default(true)
  failedLoginAttempts   Int             @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  cutterProfile         CutterProfile?
  overrides             ItemOverride[]  @relation("OverrideUpdater")
  auditEvents           AuditLog[]      @relation("AuditActor")
}

model CutterProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  displayName String
  sourceSheet String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  items       SourceItem[]
}

model SourceConnection {
  id                   String     @id @default(uuid())
  provider             String
  spreadsheetId        String
  allowedSheets        String[]
  syncIntervalMinutes  Int        @default(5)
  lastSuccessfulSyncAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  syncRuns             SyncRun[]
}

model SourceItem {
  id              String         @id @default(uuid())
  sourceUid       String         @unique
  cutterId        String
  sourceSheet     String
  sourceRowRef    String
  sourcePayload   Json
  sourceUpdatedAt DateTime?
  syncedAt        DateTime       @default(now())
  isArchived      Boolean        @default(false)
  checksum        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cutter          CutterProfile  @relation(fields: [cutterId], references: [id])
  overrides       ItemOverride[]

  @@index([cutterId, isArchived])
  @@index([sourceSheet])
}

model ItemOverride {
  id        String     @id @default(uuid())
  itemId    String
  cutterId  String
  fieldName String
  value     Json
  updatedAt DateTime   @updatedAt
  updatedBy String
  item      SourceItem @relation(fields: [itemId], references: [id])
  updater   User       @relation("OverrideUpdater", fields: [updatedBy], references: [id])

  @@unique([itemId, fieldName])
  @@index([cutterId])
}

model SyncRun {
  id                 String           @id @default(uuid())
  sourceConnectionId String
  status             SyncRunStatus    @default(RUNNING)
  startedAt          DateTime         @default(now())
  finishedAt         DateTime?
  insertedCount      Int              @default(0)
  updatedCount       Int              @default(0)
  archivedCount      Int              @default(0)
  errorCount         Int              @default(0)
  sourceConnection   SourceConnection @relation(fields: [sourceConnectionId], references: [id])
  errors             SyncError[]
}

model SyncError {
  id        String   @id @default(uuid())
  syncRunId String
  sheet     String
  sourceRef String?
  message   String
  createdAt DateTime @default(now())
  syncRun   SyncRun  @relation(fields: [syncRunId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entity        String
  before        Json?
  after         Json?
  correlationId String
  createdAt     DateTime @default(now())
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
}
