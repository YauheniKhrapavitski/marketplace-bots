# Copy this file to .env on the VPS and fill in real values.

# Domain must point to the VPS public IP before starting Caddy.
DOMAIN=n8n.example.com

# n8n public URL settings.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# Keep this value stable. If it changes, existing n8n credentials can become unreadable.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-generate-random-64-hex-chars

# PostgreSQL.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-long-random-db-password

