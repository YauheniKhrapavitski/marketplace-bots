# Dedicated Ozon Reviews PostgreSQL. Use an alphanumeric password so it is URL-safe.
OZON_DB_NAME=ozon_reviews
OZON_DB_USER=ozon_app
OZON_DB_PASSWORD=

OZON_TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
APP_ENCRYPTION_KEY=
BRAND_NAME=
ANSWER_SIGNATURE=
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=10
FEEDBACK_SCHEDULER_ENABLED=false
QUESTION_SCHEDULER_ENABLED=false
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_ENVIRONMENT=production
OZON_HTTP_CONNECT_TIMEOUT=10
OZON_HTTP_READ_TIMEOUT=30
OZON_HTTP_MAX_RETRIES=3
